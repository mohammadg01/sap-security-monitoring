<!--
  Eigene Wazuh-Regeln für simulierte SAP-Security-Audit-Log-Einträge.
  Benötigt den Decoder "sap-audit" (wazuh/sap_decoder.xml).
  Regel-IDs 100100-100106, MITRE-ATT&CK-Zuordnung wo sinnvoll.
-->

<group name="sap,sap_audit,">

  <!-- Basisregel: erkennt alle SAP-Audit-Ereignisse (kein Alarm) -->
  <rule id="100100" level="0">
    <decoded_as>sap-audit</decoded_as>
    <description>SAP Security Audit Log Ereignis</description>
  </rule>

  <!-- AU1: erfolgreicher Login -->
  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <field name="sap_msgid" type="pcre2">^AU1$</field>
    <description>SAP: Login erfolgreich - Benutzer $(dstuser), Mandant $(sap_client)</description>
    <group>authentication_success,</group>
  </rule>

  <!-- AU2: fehlgeschlagener Login -->
  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <field name="sap_msgid" type="pcre2">^AU2$</field>
    <description>SAP: Login fehlgeschlagen - Benutzer $(dstuser) von $(srcip)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <!-- 5 fehlgeschlagene Logins von derselben IP innerhalb von 2 Minuten -->
  <rule id="100103" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100102</if_matched_sid>
    <same_srcip />
    <description>SAP: Brute-Force-Verdacht - viele fehlgeschlagene Logins von $(srcip)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- Erfolgreicher Login mit Standardbenutzer SAP* oder DDIC -->
  <rule id="100104" level="12">
    <if_sid>100101</if_sid>
    <user type="pcre2">^(SAP\*|DDIC)$</user>
    <description>SAP: Login mit Standardbenutzer $(dstuser)</description>
    <mitre><id>T1078.001</id></mitre>
  </rule>

  <!-- AU3: Start einer kritischen Transaktion (Benutzer, Rechte, Programme, Audit-Log) -->
  <rule id="100105" level="8">
    <if_sid>100100</if_sid>
    <field name="sap_msgid" type="pcre2">^AU3$</field>
    <field name="sap_tcode" type="pcre2">^(SU01|SU10|PFCG|SE38|SM19|RSAU_CONFIG)$</field>
    <description>SAP: Kritische Transaktion $(sap_tcode) gestartet von $(dstuser)</description>
  </rule>

  <!-- AUM: Benutzer nach zu vielen Fehlversuchen gesperrt -->
  <rule id="100106" level="10">
    <if_sid>100100</if_sid>
    <field name="sap_msgid" type="pcre2">^AUM$</field>
    <description>SAP: Benutzer nach zu vielen Fehlversuchen gesperrt</description>
  </rule>

</group>
